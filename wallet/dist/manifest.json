{
  "manifest_version": 3,
  "name": "Acki Nacki Wallet (shellnet)",
  "version": "0.1.0",
  "description": "Browser wallet for Acki Nacki shellnet: sends ABI messages, native SHELL/VMSHELL transfers, MetaMask-style bridge for SIIR site.",
  "action": {
    "default_title": "Acki Nacki Wallet",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "offscreen", "scripting", "tabs"],
  "host_permissions": ["https://shellnet.ackinacki.org/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "minimum_chrome_version": "116",
  "web_accessible_resources": [
    {
      "resources": ["tvmsdk.wasm", "libweb-wrapper.mjs", "abi/*"],
      "matches": ["<all_urls>"]
    }
  ]
}